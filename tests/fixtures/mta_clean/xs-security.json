{
  "xsappname": "my-clean-app",
  "tenant-mode": "dedicated",
  "scopes": [
    {
      "name": "$XSAPPNAME.read",
      "description": "Read access",
      "grant-as-authority-to-apps": ["my-clean-app!t12345"]
    }
  ],
  "role-templates": [
    {
      "name": "Viewer",
      "description": "Read-only access",
      "scope-references": ["$XSAPPNAME.read"]
    }
  ],
  "oauth2-configuration": {
    "token-validity": 3600
  }
}
